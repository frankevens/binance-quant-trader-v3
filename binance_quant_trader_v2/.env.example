# Binance Quant Trader V2 - Environment Configuration
# ====================================================
# Copy this file to .env and fill in your API credentials.
# NEVER commit .env to version control.

# === Binance API Credentials ===
# Get your API key from: https://www.binance.com/en/my/settings/api-management
# Required permissions: Enable Futures, Enable Reading
# IMPORTANT: For security, restrict IP whitelist to your server IP only.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# === Optional Overrides ===
# LOG_LEVEL=INFO
# DB_PATH=trader_data/trades.db
